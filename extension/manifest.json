{
  "manifest_version": 3,
  "name": "Patina",
  "version": "0.1.0",
  "description": "Le pasa a Patina la página (y en WhatsApp, quién envió el mensaje) del texto que resaltás.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "favicon",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
