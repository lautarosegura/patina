def write_atomic(path: str, data: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w") as f:
        f.write(data)
    os.replace(tmp, path)


def read_text(path: str) -> str:
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return ""


def run(cmd: list[str], stdin: str | None = None) -> str:
    try:
        return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def notify(summary: str, body: str = "") -> None:
    subprocess.Popen(
        ["notify-send", "-a", "Patina", "-t", "1800", "-h", "string:x-dunst-stack-tag:patina", summary, body],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


# Las dos instancias de WhatsApp son ventanas de Brave; solo el título las distingue:
# "WhatsApp - Brave" y "(19) WhatsApp Business - Brave".
WHATSAPP_TITLE = re.compile(r"^(?:\(\d+\) )?(WhatsApp(?: Business)?) - ")
SELECTION_MAX_AGE_S = 600
# Una selección sin capturar vence a los 10 segundos: en Wayland la selección primaria sigue
# disponible aunque en pantalla ya no haya nada seleccionado.
PRIMARY_MAX_AGE_S = 10


def active_window() -> dict:
    try:
        return json.loads(run(["hyprctl", "activewindow", "-j"]) or "{}")
    except json.JSONDecodeError:
        return {}


def window_source(win: dict) -> str:
    if m := WHATSAPP_TITLE.match(win.get("title") or ""):
        return m.group(1)
    # "com.t3tools.T3Code" -> "T3Code"; las clases simples quedan igual.
    return (win.get("class") or "").rsplit(".", 1)[-1]


def parse_sent(raw: str, order: str = "") -> str:
    """Convierte la hora de WhatsApp ("20:27, 13/10/2026" o "8:27 PM, 10/13/2026") a ISO.

    El formato depende del idioma del navegador; la extensión manda el orden de la fecha.
    Sin orden, se deduce cuando un número pasa de 12 y si no se asume día/mes.
    """
    t = re.search(r"(\d{1,2})[:.](\d{2})\s*([ap])?\.?\s*m?\.?", raw, re.IGNORECASE)
    d = re.search(r"(\d{1,4})[/.-](\d{1,2})[/.-](\d{1,4})", raw)
    if not t or not d:
        return ""
    hour, minute, ampm = int(t[1]), int(t[2]), (t[3] or "").lower()
    if ampm:
        hour = hour % 12 + (12 if ampm == "p" else 0)
    a, b, c = (int(x) for x in d.groups())
    if not order:
        order = "ymd" if a > 31 else "mdy" if b > 12 else "dmy"
    year, month, day = {"dmy": (c, b, a), "mdy": (c, a, b), "ymd": (a, b, c)}[order]
    try:
        return datetime(year if year > 99 else 2000 + year, month, day, hour, minute).isoformat(timespec="minutes")
    except ValueError:
        return ""


def squash(text: str) -> str:
    return " ".join(text.split())


def no_spaces(text: str) -> str:
    return "".join(text.split())


def page_text(text: str) -> str:
    """El texto como lo armó la extensión, si es el mismo que la selección salvo espacios.

    Chromium corta la línea alrededor de elementos inline-flex (las menciones de X: "asking
    \n@bot\n:"); la extensión arma el texto como se ve. Solo cambian espacios y saltos de línea.
    """
    selection = read_json(SELECTION_PATH)
    candidate = selection.get("text", "")
    recent = time.time() - selection.get("received", 0) <= SELECTION_MAX_AGE_S
    if recent and candidate.strip() and no_spaces(candidate) == no_spaces(text):
        return candidate
    return text


def read_json(path: str) -> dict:
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def page_fields(page: dict) -> dict:
    return {k: page[k] for k in ("url", "title", "host", "favicon") if page.get(k)}


def browser_context(text: str, window_title: str) -> dict:
    """De dónde viene el texto capturado, en este orden:

    1. La selección que mandó la extensión desde la página, si es este texto: en WhatsApp,
       remitente, hora y chat; en otras páginas, URL, título y favicon.
    2. La pestaña activa de Brave, si es la de la ventana con foco. Cubre lo que no se selecciona
       dentro de una página, como la URL de la barra de direcciones.
    3. Si el texto es una URL, esa URL (con el favicon guardado de su dominio, si hay).
    """
    selection = read_json(SELECTION_PATH)
    # La selección primaria y la de la extensión pueden diferir en espacios y saltos de línea.
    captured, selected = no_spaces(text), no_spaces(selection.get("text", ""))
    recent = time.time() - selection.get("received", 0) <= SELECTION_MAX_AGE_S
    if not captured:
        return {}
    if not (recent and selected and (captured == selected or captured in selected or selected in captured)):
        page = read_json(PAGE_PATH)
        # Brave titula la ventana "<título de la pestaña> - Brave".
        if page.get("title") and window_title.startswith(page["title"] + " - "):
            return page_fields(page)
        if URL_RE.fullmatch(captured):
            host = urlsplit(captured).hostname or ""
            favicon = favicon_name(host) if os.path.exists(os.path.join(FAVICON_DIR, favicon_name(host))) else ""
            return page_fields({"url": captured, "host": host, "favicon": favicon})
        return {}
    messages = selection.get("messages") or []
    if not messages:
        return page_fields(selection)
    senders = list(dict.fromkeys(m["sender"] for m in messages if m.get("sender")))
    raw_sent = messages[0]["time"] if messages else ""
    context = {"sender": ", ".join(senders), "sent": parse_sent(raw_sent, selection.get("date_order", "")) or raw_sent}
    chat = selection.get("chat", "")
    if chat and chat not in senders:  # en un chat individual el nombre del chat repite al remitente
        context["chat"] = chat
    return {k: v for k, v in context.items() if v}


class Store:
    """Lista de items persistida en un JSON. Este proceso es el único que escribe."""

    def __init__(self) -> None:
        self.items = load_json_list(ITEMS_PATH)
        # Lo que sale de la cola (limpiar completados o Supr) pasa acá, el más reciente al final.
        self.history = load_json_list(HISTORY_PATH)

    def save(self) -> None:
        write_atomic(ITEMS_PATH, json.dumps(self.items, ensure_ascii=False, indent=1))

    def save_history(self) -> None:
        write_atomic(HISTORY_PATH, json.dumps(self.history, ensure_ascii=False, indent=1))

    def archive(self, items: list[dict]) -> None:
        """Saca items de la cola y los guarda en el historial."""
        if not items:
            return
        now = datetime.now().isoformat(timespec="seconds")
        ids = {i["id"] for i in items}
        self.items = [i for i in self.items if i["id"] not in ids]
        self.history.extend({**i, "archived": now} for i in items)
        self.save_history()
        self.save()

    def restore(self, item_id: str) -> None:
        item = next((i for i in self.history if i["id"] == item_id), None)
        if item:
            self.history.remove(item)
            restored = {k: v for k, v in item.items() if k != "archived"}
            self.items.append({**restored, "done": False})
            self.save()
            self.save_history()

    def forget(self, item_id: str) -> None:
        self.history = [i for i in self.history if i["id"] != item_id]
        self.save_history()

    def add(self, kind: str, text: str, source: str = "", extra: dict | None = None) -> bool:
        text = text.strip("\n")
        if not text.strip():
            return False
        last = self.items[-1] if self.items else None
        if last and last["text"] == text and not last["done"]:
            return False  # el mismo texto capturado dos veces seguidas
        self.items.append({
            "id": uuid.uuid4().hex, "kind": kind, "text": text, "source": source,
            "created": datetime.now().isoformat(timespec="seconds"), "done": False, **(extra or {}),
        })
        self.save()
        return True

    def find(self, item_id: str) -> dict | None:
        return next((i for i in self.items if i["id"] == item_id), None)


def load_json_list(path: str) -> list[dict]:
    try:
        return json.loads(read_text(path) or "[]")
    except json.JSONDecodeError:
        os.replace(path, path + ".corrupt")
        return []


def linkify(text: str) -> str:
    """Markup de Pango con las URLs del texto como links; el resto queda escapado."""
    out, pos = [], 0
    for m in URL_RE.finditer(text):
        url = m.group().rstrip(".,;:!?)]}")
        out.append(GLib.markup_escape_text(text[pos:m.start()]))
        escaped = GLib.markup_escape_text(url)
        out.append(f'<a href="{escaped}">{escaped}</a>')
        pos = m.start() + len(url)
    out.append(GLib.markup_escape_text(text[pos:]))
    return "".join(out)


def format_time(iso: str) -> str:
    return datetime.fromisoformat(iso).strftime("%d/%m %H:%M")


def format_sent(sent: str) -> str:
    try:
        return format_time(sent)
    except ValueError:  # capturas viejas guardaron el texto de WhatsApp sin convertir
        iso = parse_sent(sent)
        return format_time(iso) if iso else sent


