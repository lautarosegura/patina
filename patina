class PatinaWindow(Adw.ApplicationWindow):
    def __init__(self, app: "PatinaApp") -> None:
        super().__init__(application=app, title="Patina", default_width=560, default_height=680)
        self.app = app
        self.store = app.store
        self.add_css_class("patina")
        self.connect("close-request", lambda *_: self.set_visible(False) or True)

        self.stack = Adw.ViewStack()
        # Sin minimizar ni maximizar: Hyprland no los maneja y dejarían la ventana en un estado ambiguo.
        header = Adw.HeaderBar(
            title_widget=Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE),
            decoration_layout=":close",
        )
        clear = Gtk.Button(icon_name="edit-clear-all-symbolic", tooltip_text="Borrar los completados (Ctrl+Shift+Retroceso)")
        clear.connect("clicked", lambda *_: self.clear_done())
        header.pack_end(clear)

        self.stack.add_titled_with_icon(self.build_queue(), "queue", "Cola", "view-list-symbolic")
        self.stack.add_titled_with_icon(self.build_notes(), "notes", "Notas", "document-edit-symbolic")
        self.stack.add_titled_with_icon(self.build_history(), "history", "Historial", "document-open-recent-symbolic")
        self.stack.connect("notify::visible-child-name", lambda *_: clear.set_visible(self.stack.get_visible_child_name() == "queue"))

        view = Adw.ToolbarView(content=self.stack)
        view.add_top_bar(header)
        self.set_content(view)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_window_key)
        self.add_controller(keys)
        self.refresh()

    # --- Cola ---

    def build_queue(self) -> Gtk.Widget:
        self.entry = Gtk.Entry(placeholder_text="Escribí un prompt y Enter…", hexpand=True)
        self.entry.connect("activate", self.on_entry_activate)
        entry_keys = Gtk.EventControllerKey()
        entry_keys.connect("key-pressed", self.on_entry_key)
        self.entry.add_controller(entry_keys)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, css_classes=["boxed-list"], valign=Gtk.Align.START)
        # Un click solo selecciona; Enter o doble click activan la fila (copiar y ocultar).
        self.list.set_activate_on_single_click(False)
        self.list.connect("row-activated", lambda _l, row: self.copy(row.item_id))
        list_keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        list_keys.connect("key-pressed", self.on_list_key)
        self.list.add_controller(list_keys)

        self.empty = Adw.StatusPage(
            icon_name="edit-paste-symbolic", title="Nada en la cola",
            description="Seleccioná texto en cualquier app y tocá Shift dos veces.\nO escribí tus próximos prompts acá arriba.",
            vexpand=True,
        )
        clamp = Adw.Clamp(child=self.list, maximum_size=720, margin_top=6, margin_bottom=12, margin_start=12, margin_end=12)
        self.scroller = Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)

        self.queue_stack = Gtk.Stack()
        self.queue_stack.add_named(self.empty, "empty")
        self.queue_stack.add_named(self.scroller, "list")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(Adw.Clamp(child=self.entry, maximum_size=720, margin_top=12, margin_start=12, margin_end=12, margin_bottom=6))
        box.append(self.queue_stack)
        return box

    def build_row(self, item: dict) -> Gtk.ListBoxRow:
        check = Gtk.CheckButton(active=item["done"], valign=Gtk.Align.START, can_focus=False)
        check.connect("toggled", lambda b: self.set_done(item["id"], b.get_active()))

        box = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10, margin_start=12, margin_end=6)
        column = self.build_item_column(item)
        column.set_tooltip_text("Enter, Ctrl+C o doble click: copiar y volver a la app · Espacio: tachar · Supr: borrar")
        box.append(check)
        box.append(column)
        box.append(self.build_copy_button(item["text"]))

        row = Gtk.ListBoxRow(child=box)
        row.item_id = item["id"]
        if item["done"]:
            row.add_css_class("done")
        return row

    def build_copy_button(self, text: str) -> Gtk.Button:
        """Aparece al pasar el mouse por la fila. Solo copia: no tacha el item ni oculta la ventana."""
        done = Gtk.Box(spacing=4)
        done.append(Gtk.Image(icon_name="object-select-symbolic"))
        done.append(Gtk.Label(label="¡Copiado!"))
        # El stack mide lo que el estado más ancho: el botón no cambia de tamaño al alternar.
        states = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_UP_DOWN, transition_duration=220)
        states.add_named(Gtk.Label(label="Copiar"), "idle")
        states.add_named(done, "copied")
        button = Gtk.Button(child=states, valign=Gtk.Align.START, can_focus=False, css_classes=["flat", "copy-button"])
        button.set_cursor_from_name("pointer")
        timer = 0

        def reset() -> bool:
            nonlocal timer
            timer = 0
            states.set_visible_child_name("idle")
            button.remove_css_class("copied")
            return False

        def copied(*_) -> None:
            nonlocal timer
            self.copy_text(text, hide=False)
            states.set_visible_child_name("copied")
            button.add_css_class("copied")  # queda visible aunque el mouse salga de la fila
            if timer:
                GLib.source_remove(timer)
            timer = GLib.timeout_add(1400, reset)

        button.connect("clicked", copied)
        return button

    def build_item_column(self, item: dict) -> Gtk.Widget:
        text = Gtk.Label(
            label=linkify(item["text"]), use_markup=True, xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR,
            lines=4, ellipsize=Pango.EllipsizeMode.END, selectable=False, css_classes=["item-text"],
        )
        self.handle_links(text)

        icon, tooltip, host = None, None, None
        if item.get("sender"):
            # Mensaje de WhatsApp: ícono, remitente (grupo) y hora de envío; la instancia va en el tooltip.
            who = item["sender"] + (f" ({item['chat']})" if item.get("chat") else "")
            meta_parts = [who, format_sent(item["sent"]) if item.get("sent") else format_time(item["created"])]
            icon, tooltip = self.app.whatsapp_icon, item.get("source") or "WhatsApp"
        elif item.get("host"):
            # Captura del navegador: favicon, dominio y hora; título y URL van en el tooltip.
            host = self.build_host_label(item)
            meta_parts = [format_time(item["created"])]
            icon = self.app.favicon(item.get("favicon", ""))
            tooltip = "\n".join(x for x in (item.get("title"), item.get("url")) if x)
        else:
            meta_parts = ["captura" if item["kind"] == "capture" else "prompt"]
            if item.get("source"):
                meta_parts.append(item["source"])
            meta_parts.append(format_time(item["created"]))
        if item.get("archived"):
            meta_parts.append("archivado " + format_time(item["archived"]))
        text_meta = " · ".join(meta_parts)
        meta = Gtk.Label(label=f" · {text_meta}" if host else text_meta, xalign=0, wrap=True, hexpand=True, css_classes=["item-meta"])
        if item["kind"] == "capture":
            meta.add_css_class("kind-capture")

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        col.append(text)
        if tooltip is not None:
            line = Gtk.Box(spacing=6, tooltip_text=tooltip)
            image = Gtk.Image(paintable=icon, pixel_size=14, valign=Gtk.Align.CENTER) if icon else \
                Gtk.Image(icon_name="globe-symbolic", pixel_size=14, valign=Gtk.Align.CENTER)
            line.append(image)
            if host:
                pair = Gtk.Box(hexpand=True)  # dominio y hora pegados, sin el espacio del contenedor
                pair.append(host)
                pair.append(meta)
                line.append(pair)
            else:
                line.append(meta)
            col.append(line)
        else:
            col.append(meta)
        return col

    def build_host_label(self, item: dict) -> Gtk.Label:
        """El dominio de una captura del navegador; con un click abre la página donde se copió el texto."""
        label = Gtk.Label(label=item["host"], css_classes=["item-meta"])
        if item["kind"] == "capture":
            label.add_css_class("kind-capture")
        if not item.get("url"):
            return label
        label.set_cursor_from_name("pointer")
        # Subrayado al pasar el mouse. Va como atributo de Pango: GTK no redibuja un text-decoration
        # que cambia por una clase CSS agregada en vivo.
        underline = Pango.AttrList()
        underline.insert(Pango.attr_underline_new(Pango.Underline.SINGLE))
        hover = Gtk.EventControllerMotion()
        hover.connect("enter", lambda *_: label.set_attributes(underline))
        hover.connect("leave", lambda *_: label.set_attributes(None))
        label.add_controller(hover)
        # Fase de captura y click reclamado: la fila no se activa (no copia ni tacha el item).
        click = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE, button=Gdk.BUTTON_PRIMARY)
        click.connect("pressed", lambda gesture, *_: (gesture.set_state(Gtk.EventSequenceState.CLAIMED), self.open_uri(item["url"])))
        label.add_controller(click)
        return label

    def handle_links(self, label: Gtk.Label) -> None:
        # GtkLabel ya pone el cursor de mano sobre los links. Este gesto en fase de captura abre el
        # link y reclama el click, así la fila no se activa (no copia ni marca el item como completado).
        link_click = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        link_click.connect("pressed", self.on_link_pressed, label)
        label.add_controller(link_click)
        label.connect("activate-link", lambda _l, uri: self.open_uri(uri) or True)

    def on_link_pressed(self, gesture: Gtk.GestureClick, _n, _x, _y, label: Gtk.Label) -> None:
        uri = label.get_current_uri()
        if uri and gesture.get_current_button() == Gdk.BUTTON_PRIMARY:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            self.open_uri(uri)

    def open_uri(self, uri: str) -> None:
        Gtk.UriLauncher(uri=uri).launch(self, None, None, None)

    def refresh(self) -> None:
        self.refresh_history()
        selected = self.list.get_selected_row()
        selected_index = selected.get_index() if selected else -1
        self.list.remove_all()
        for item in self.store.items:
            self.list.append(self.build_row(item))
        self.queue_stack.set_visible_child_name("list" if self.store.items else "empty")
        if selected_index >= 0:
            row = self.list.get_row_at_index(min(selected_index, len(self.store.items) - 1))
            if row:
                self.list.select_row(row)
                row.grab_focus()

    def selected_id(self) -> str | None:
        row = self.list.get_selected_row()
        return row.item_id if row else None

    def scroll_to_end(self) -> None:
        adj = self.scroller.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(adj.get_upper()) and False)

    # --- Acciones ---

    def copy(self, item_id: str | None) -> None:
        """Copia y oculta Patina para pegar en la otra app. Tachar es aparte (checkbox o Espacio)."""
        item = self.store.find(item_id) if item_id else None
        if item:
            self.copy_text(item["text"])

    def copy_text(self, text: str, hide: bool = True) -> None:
        # wl-copy queda en segundo plano sirviendo el portapapeles: sin pipes para no esperarlo.
        subprocess.run(["wl-copy"], input=text, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if hide:
            self.set_visible(False)  # volver a la app donde se va a pegar

    def set_done(self, item_id: str, done: bool) -> None:
        item = self.store.find(item_id)
        if item and item["done"] != done:
            item["done"] = done
            self.store.save()
            GLib.idle_add(lambda: self.refresh() and False)

    def delete(self, item_id: str | None) -> None:
        item = self.store.find(item_id) if item_id else None
        if item:
            self.store.archive([item])
            self.refresh()
            if not self.store.items:
                self.entry.grab_focus()

    def move(self, item_id: str | None, delta: int) -> None:
        item = self.store.find(item_id) if item_id else None
        if not item:
            return
        items = self.store.items
        i = items.index(item)
        j = i + delta
        if 0 <= j < len(items):
            items[i], items[j] = items[j], items[i]
            self.store.save()
            self.refresh()
            row = self.list.get_row_at_index(j)
            self.list.select_row(row)
            row.grab_focus()

    def clear_done(self) -> None:
        self.store.archive([i for i in self.store.items if i["done"]])
        self.refresh()

    def on_entry_activate(self, entry: Gtk.Entry) -> None:
        if self.store.add("prompt", entry.get_text()):
            entry.set_text("")
            self.refresh()
            self.scroll_to_end()

    def focus_list(self) -> None:
        row = self.list.get_selected_row() or self.list.get_row_at_index(0)
        if row:
            self.list.select_row(row)
            row.grab_focus()

    # --- Teclado ---

    def on_entry_key(self, _c, keyval, _code, _state) -> bool:
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Tab) and self.store.items:
            self.focus_list()
            return True
        return False

    def on_list_key(self, _c, keyval, _code, state) -> bool:
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        item_id = self.selected_id()
        if ctrl and keyval in (Gdk.KEY_c, Gdk.KEY_C):
            self.copy(item_id)
        elif keyval == Gdk.KEY_space and item_id:
            item = self.store.find(item_id)
            self.set_done(item_id, not item["done"])
        elif keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.delete(item_id)
        elif ctrl and keyval == Gdk.KEY_Up:
            self.move(item_id, -1)
        elif ctrl and keyval == Gdk.KEY_Down:
            self.move(item_id, 1)
        elif keyval == Gdk.KEY_Up and self.list.get_selected_row() == self.list.get_row_at_index(0):
            self.entry.grab_focus()
        else:
            return False
        return True

    def on_window_key(self, _c, keyval, _code, state) -> bool:
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        shift = state & Gdk.ModifierType.SHIFT_MASK
        if keyval == Gdk.KEY_Escape:
            self.set_visible(False)
        elif ctrl and keyval in (Gdk.KEY_n, Gdk.KEY_l):
            self.stack.set_visible_child_name("queue")
            self.entry.grab_focus()
        elif ctrl and keyval == Gdk.KEY_1:
            self.stack.set_visible_child_name("queue")
            self.entry.grab_focus()
        elif ctrl and keyval == Gdk.KEY_2:
            self.stack.set_visible_child_name("notes")
            self.notes.grab_focus()
        elif ctrl and keyval == Gdk.KEY_3:
            self.stack.set_visible_child_name("history")
            self.history_search.grab_focus()
        elif ctrl and shift and keyval == Gdk.KEY_BackSpace:
            self.clear_done()
        else:
            return False
        return True

    # --- Historial ---

    def build_history(self) -> Gtk.Widget:
        self.history_search = Gtk.SearchEntry(placeholder_text="Buscar en el historial…", hexpand=True)
        self.history_search.connect("search-changed", lambda *_: self.history_list.invalidate_filter())
        search_keys = Gtk.EventControllerKey()
        search_keys.connect("key-pressed", self.on_history_search_key)
        self.history_search.add_controller(search_keys)

        self.history_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, css_classes=["boxed-list"], valign=Gtk.Align.START)
        self.history_list.set_filter_func(self.history_filter)
        self.history_list.set_activate_on_single_click(False)
        self.history_list.connect("row-activated", lambda _l, row: self.copy_text(row.item_text))
        list_keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        list_keys.connect("key-pressed", self.on_history_key)
        self.history_list.add_controller(list_keys)

        empty = Adw.StatusPage(
            icon_name="document-open-recent-symbolic", title="Historial vacío",
            description="Lo que limpies o borres de la cola queda guardado acá.", vexpand=True,
        )
        clamp = Adw.Clamp(child=self.history_list, maximum_size=720, margin_top=6, margin_bottom=12, margin_start=12, margin_end=12)
        self.history_stack = Gtk.Stack()
        self.history_stack.add_named(empty, "empty")
        self.history_stack.add_named(Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER), "list")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(Adw.Clamp(child=self.history_search, maximum_size=720, margin_top=12, margin_start=12, margin_end=12, margin_bottom=6))
        box.append(self.history_stack)
        return box

    def build_history_row(self, item: dict) -> Gtk.ListBoxRow:
        restore = Gtk.Button(
            icon_name="edit-undo-symbolic", tooltip_text="Devolver a la cola (Ctrl+Z)",
            valign=Gtk.Align.START, css_classes=["flat", "circular"],
        )
        restore.connect("clicked", lambda *_: self.restore(item["id"]))
        box = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10, margin_start=12, margin_end=6)
        column = self.build_item_column(item)
        column.set_tooltip_text("Enter, Ctrl+C o doble click: copiar · Ctrl+Z: devolver a la cola · Supr: borrar para siempre")
        box.append(column)
        box.append(self.build_copy_button(item["text"]))
        box.append(restore)
        row = Gtk.ListBoxRow(child=box)
        row.item_id = item["id"]
        row.item_text = item["text"]
        row.search_text = " ".join(item.get(k, "") for k in ("text", "source", "sender", "chat", "host", "title")).casefold()
        return row

    def refresh_history(self) -> None:
        self.history_list.remove_all()
        for item in reversed(self.store.history):
            self.history_list.append(self.build_history_row(item))
        self.history_stack.set_visible_child_name("list" if self.store.history else "empty")

    def history_filter(self, row: Gtk.ListBoxRow) -> bool:
        query = self.history_search.get_text().casefold().strip()
        return not query or query in row.search_text

    def restore(self, item_id: str) -> None:
        self.store.restore(item_id)
        self.refresh()

    def on_history_search_key(self, _c, keyval, _code, _state) -> bool:
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Tab):
            rows = (self.history_list.get_row_at_index(i) for i in range(len(self.store.history)))
            row = next((r for r in rows if r and r.get_child_visible()), None)
            if row:
                self.history_list.select_row(row)
                row.grab_focus()
                return True
        return False

    def on_history_key(self, _c, keyval, _code, state) -> bool:
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        row = self.history_list.get_selected_row()
        if not row:
            return False
        if ctrl and keyval in (Gdk.KEY_c, Gdk.KEY_C):
            self.copy_text(row.item_text)
        elif ctrl and keyval in (Gdk.KEY_z, Gdk.KEY_Z):
            self.restore(row.item_id)
        elif keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            index = row.get_index()
            self.store.forget(row.item_id)
            self.refresh_history()
            next_row = self.history_list.get_row_at_index(min(index, len(self.store.history) - 1))
            if next_row:
                self.history_list.select_row(next_row)
                next_row.grab_focus()
        else:
            return False
        return True

    # --- Notas ---

    def build_notes(self) -> Gtk.Widget:
        self.notes = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, css_classes=["notes"], vexpand=True)
        buf = self.notes.get_buffer()
        buf.set_text(read_text(NOTES_PATH))
        self._notes_timer = 0
        buf.connect("changed", self.on_notes_changed)
        return Gtk.ScrolledWindow(child=self.notes)

    def on_notes_changed(self, _buf) -> None:
        if self._notes_timer:
            GLib.source_remove(self._notes_timer)
        self._notes_timer = GLib.timeout_add(400, self.save_notes)

    def save_notes(self) -> bool:
        self._notes_timer = 0
        buf = self.notes.get_buffer()
        write_atomic(NOTES_PATH, buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False))
        return False

    def show_and_focus(self) -> None:
        # Volver a mapear la ventana hace que Hyprland le dé foco aunque ya estuviera visible.
        self.set_visible(False)
        self.present()
        if self.stack.get_visible_child_name() == "queue":
            self.entry.grab_focus()
        elif self.stack.get_visible_child_name() == "history":
            self.history_search.grab_focus()


class PatinaApp(Adw.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.store: Store | None = None
        self.window: PatinaWindow | None = None

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        self.hold()  # queda vivo con la ventana oculta para responder rápido
        self.store = Store()
        self.whatsapp_icon = Gdk.Texture.new_from_bytes(GLib.Bytes.new(WHATSAPP_ICON))
        self.favicons: dict[str, Gdk.Texture | None] = {}
        self.watch_primary()
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def favicon(self, name: str) -> Gdk.Texture | None:
        if name not in self.favicons:
            try:
                self.favicons[name] = Gdk.Texture.new_from_filename(os.path.join(FAVICON_DIR, name)) if name else None
            except GLib.Error:
                self.favicons[name] = None  # el archivo se borró: se muestra el ícono genérico
        return self.favicons[name]

    def get_window(self) -> PatinaWindow:
        if not self.window:
            self.window = PatinaWindow(self)
        return self.window

    def do_command_line(self, cmdline: Gio.ApplicationCommandLine) -> int:
        args = cmdline.get_arguments()[1:]
        cmd = args[0] if args else "toggle"
        if cmd == "--service":
            return 0
        if cmd == "toggle":
            win = self.get_window()
            if win.is_visible():
                win.set_visible(False)
            else:
                win.show_and_focus()
        elif cmd == "capture":
            self.capture()
        elif cmd == "add" and len(args) > 1:
            if self.store.add("prompt", " ".join(args[1:])) and self.window:
                self.window.refresh()
        else:
            cmdline.printerr(__doc__)
            return 2
        return 0

    def watch_primary(self) -> None:
        """Anota cuándo cambia la selección primaria (wl-paste usa data-control: funciona sin foco).

        Con esto capture() descarta selecciones viejas: ya capturadas, vencidas o anteriores a la
        pestaña activa de Brave (que no actualiza la selección al hacer click en la barra de direcciones).
        """
        self.primary_changed_at = 0.0
        self.last_capture_at = 0.0
        try:
            proc = subprocess.Popen(
                ["wl-paste", "--primary", "--watch", "echo"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                preexec_fn=lambda: __import__("ctypes").CDLL(None).prctl(1, 15),  # PR_SET_PDEATHSIG, SIGTERM
            )
        except OSError:
            return
        channel = GLib.IOChannel.unix_new(proc.stdout.fileno())

        def on_change(_channel, condition) -> bool:
            if condition & GLib.IOCondition.HUP:
                return False
            proc.stdout.readline()
            first = not self.primary_changed_at
            self.primary_changed_at = time.time()
            if first:  # la selección que ya existía al arrancar no cuenta como nueva
                self.last_capture_at = self.primary_changed_at
            return True

        GLib.io_add_watch(channel, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN | GLib.IOCondition.HUP, on_change)

    def capture(self) -> None:
        text = run(["wl-paste", "--primary", "--no-newline", "--type", "text"])
        win = active_window()
        title = win.get("title") or ""
        page = read_json(PAGE_PATH)
        on_page = bool(page.get("title")) and title.startswith(page["title"] + " - ")
        changed = self.primary_changed_at
        # Sin el vigilante de wl-paste no hay cómo saberlo: se acepta la selección como antes.
        fresh = not changed or (changed > self.last_capture_at and time.time() - changed <= PRIMARY_MAX_AGE_S)
        if on_page:
            selection = read_json(SELECTION_PATH)
            # La extensión avisa cuando la selección de la página queda vacía (click en otro lado).
            if (selection.get("received", 0) > changed and selection.get("url") == page.get("url")
                    and not selection.get("text", "").strip()):
                fresh = False
            if changed and page.get("since", 0) > changed:  # seleccionada antes de llegar a esta pestaña
                fresh = False
        if not text.strip():
            fresh = False
        # En Brave, sin selección nueva se captura la página.
        if on_page and not fresh:
            if self.store.add("capture", page["url"], window_source(win), page_fields(page)):
                notify("Capturada la página", page["url"])
                if self.window:
                    self.window.refresh()
            return
        if not fresh:
            notify("Patina", "No hay texto seleccionado")
            return
        self.last_capture_at = time.time()
        context = browser_context(text, title)
        text = page_text(text)
        if self.store.add("capture", text, window_source(win), context):
            preview = " ".join(text.split())
            sender = self.store.items[-1].get("sender")
            notify(f"Capturado de {sender}" if sender else "Capturado en Patina", preview[:120] + ("…" if len(preview) > 120 else ""))
            if self.window:
                self.window.refresh()


if __name__ == "__main__":
    sys.exit(PatinaApp().run(sys.argv))
