#!/usr/bin/env python3
"""Patina: cola de prompts, capturas y bloc de notas para trabajar con IA en Hyprland.

Uso:
  patina              muestra u oculta la ventana
  patina capture      guarda el texto seleccionado (selección primaria de Wayland)
  patina add TEXTO    agrega un prompt a la cola
  patina tap          llamado por Hyprland al soltar Shift; dos taps seguidos = capture
  patina --service    arranca en segundo plano sin mostrar la ventana

El navegador ejecuta este mismo archivo como host nativo de la extensión "Patina" (extension/):
recibe la página del texto resaltado (y en WhatsApp, el remitente), la deja en
$XDG_RUNTIME_DIR/patina-selection.json para que la próxima captura la use y guarda el favicon
en $XDG_DATA_HOME/patina/favicons/.

Los datos viven en $XDG_DATA_HOME/patina (items.json, historial.json y notas.md). No sincroniza nada.
"""

import os
import sys
import time

APP_ID = "io.github.lautarosegura.Patina"
DOUBLE_TAP_MS = 350
SELECTION_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "patina-selection.json")
PAGE_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "patina-page.json")  # pestaña activa de Brave
FAVICON_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "patina", "favicons"
)


def tap() -> None:
    """Detecta el doble Shift sin cargar GTK: cada tap cuesta un arranque de Python."""
    stamp = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "patina-shift")
    now = time.monotonic_ns() // 1_000_000
    try:
        with open(stamp) as f:
            last = int(f.read() or 0)
    except (OSError, ValueError):
        last = 0
    if 0 <= now - last < DOUBLE_TAP_MS:
        os.unlink(stamp)
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), "capture"])
    with open(stamp, "w") as f:
        f.write(str(now))


def favicon_name(host: str) -> str:
    import hashlib

    return hashlib.sha256(host.encode()).hexdigest()[:20] + ".png"


def write_private(path: str, data: dict) -> None:
    import json

    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)  # contiene texto seleccionado y URLs
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def native_host() -> None:
    """Protocolo de native messaging: mensajes JSON con un prefijo de 4 bytes de largo.

    Tampoco carga GTK: Brave lanza un proceso por cada selección.
    """
    import base64
    import binascii
    import json
    import struct
    from urllib.parse import urlsplit

    def save_favicon(host: str, encoded: str) -> str:
        """Guarda el PNG por dominio y devuelve el nombre del archivo, o "" si no es un PNG válido."""
        try:
            png = base64.b64decode(encoded, validate=True)
        except (binascii.Error, ValueError):
            return ""
        if not png.startswith(b"\x89PNG\r\n\x1a\n") or len(png) > 256_000:
            return ""
        name = favicon_name(host)
        os.makedirs(FAVICON_DIR, exist_ok=True)
        tmp = os.path.join(FAVICON_DIR, name + ".tmp")
        with open(tmp, "wb") as f:
            f.write(png)
        os.replace(tmp, os.path.join(FAVICON_DIR, name))
        return name

    def message(raw: bytes) -> dict | None:
        try:
            data = json.loads(raw)
            url = str(data.get("url", ""))
            host = urlsplit(url).hostname or ""
            entries = [{"time": str(m["time"]), "sender": str(m["sender"])} for m in data.get("messages", [])]
            order = data.get("dateOrder") if data.get("dateOrder") in ("dmy", "mdy", "ymd") else ""
            favicon = save_favicon(host, data["favicon"]) if host and isinstance(data.get("favicon"), str) else ""
            if data.get("kind") == "page":
                # "since": desde cuándo está activa esta pestaña con esta URL. Un cambio de título
                # (contador de no leídos, video que avanza) no la reinicia.
                tab = str(data.get("tab", ""))
                try:
                    with open(PAGE_PATH) as f:
                        previous = json.load(f)
                except (OSError, ValueError):
                    previous = {}
                same = previous.get("tab") == tab and previous.get("url") == url
                return {"kind": "page", "tab": tab, "url": url, "host": host, "title": str(data.get("title", "")),
                        "favicon": favicon, "since": previous.get("since", 0) if same else time.time(),
                        "received": time.time()}
            return {"text": str(data["text"]), "url": url, "host": host, "title": str(data.get("title", "")),
                    "favicon": favicon, "messages": entries, "chat": str(data.get("chat", "")),
                    "date_order": order, "received": time.time()}
        except (ValueError, TypeError, KeyError):
            return None

    stdin, stdout = sys.stdin.buffer, sys.stdout.buffer
    while header := stdin.read(4):
        (length,) = struct.unpack("<I", header)
        selection = message(stdin.read(length))
        if selection:
            write_private(PAGE_PATH if selection.get("kind") == "page" else SELECTION_PATH, selection)
        reply = json.dumps({"ok": bool(selection)}).encode()
        stdout.write(struct.pack("<I", len(reply)) + reply)
        stdout.flush()


if __name__ == "__main__" and sys.argv[1:2] == ["tap"]:
    tap()
    sys.exit(0)
if __name__ == "__main__" and sys.argv[1:2] and sys.argv[1].startswith("chrome-extension://"):
    native_host()
    sys.exit(0)


