{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patina",
  "version": "0.2.0",
  "identifier": "io.github.lautarosegura.Patina",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "category": "Productivity",
    "shortDescription": "Prompt queue and capture inbox",
    "longDescription": "Patina keeps a queue of prompts, captures highlighted text with its source page or WhatsApp sender, and a scratchpad. Everything stays on your machine.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "../extension/": "extension/" },
    "linux": {
      "deb": { "depends": ["wl-clipboard", "libnotify-bin"] },
      "rpm": { "depends": ["wl-clipboard", "libnotify"] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
